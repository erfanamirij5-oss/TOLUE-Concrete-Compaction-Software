{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOLUE Concrete Compaction",
  "version": "0.1.0",
  "identifier": "com.tolue.concretecompaction",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TOLUE Concrete Compaction",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [],
    "shortDescription": "3D concrete packing and compaction engineering software",
    "longDescription": "TOLUE Concrete Compaction is a project-based 3D engineering platform for concrete mix visualization, packing, compaction analysis, comparison, and standards-based diagnostics."
  }
}
